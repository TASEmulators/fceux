/*-----QWidget-----*/
/* FCEUX adaptation: font-relative metrics and embedded vector indicators. */
QWidget
{
	background-color: #121212;
	color: #ffffff;
	border-color: #051a39;

}


/*-----QLabel-----*/
QLabel
{
	background-color: transparent;
	color: #ffffff;

}


QLabel:disabled
{
	background-color: transparent;
	color: #656565;

}


/*-----QMenuBar-----*/
QMenuBar
{
	background-color: #0a0a0a;
	color: #ffffff;
	border-color: #051a39;

}


QMenuBar:disabled
{
	background-color: #404040;
	color: #656565;
	border-color: #051a39;

}


QMenuBar::item
{
    background-color: transparent;

}


QMenuBar::item:selected
{
    background-color: #607cff;
    border: 0.08em solid #41cd52;

}


QMenuBar::item:pressed
{
    background-color: #4969ff;
    border: 0.08em solid #000;
    margin-bottom: -0.08em;
    padding-bottom: 0.08em;

}


/*-----QMenu-----*/
QMenu
{
    background-color: #121212;
    border: 0.08em solid;
    color: #ffffff;

}


QMenu::separator
{
    height: 0.08em;
    background-color: #6d8eff;
    color: #ffffff;
    padding-left: 0.32em;
    margin-left: 0.8em;
    margin-right: 0.4em;

}


QMenu::item
{
    min-width : 12em;
    padding: 0.24em 1.6em 0.24em 1.6em;

}


QMenu::item:selected
{
    background-color: #4969ff;
    color: #ffffff;

}


QMenu::item:disabled
{
    color: #262626;
}


/*-----QToolTip-----*/
QToolTip
{
	border : 0.08em solid #000000;
	background-color: #26264f;
	color: #ffffff;
	border-color: #051a39;

}


/*-----QPushButton-----*/
QPushButton
{
	background-color: #607cff;
	color: #ffffff;
	border-style: solid;
	border-width: 0.08em;
	border-radius: 0.24em;
	border-color: #051a39;
	padding: 0.4em;

}


QPushButton:disabled
{
	background-color: #404040;
	color: #656565;
	border-color: #051a39;

}


QPushButton:hover
{
	background-color: #8399ff;
	color: #ffffff;
	border-style: solid;
	border-width: 0.08em;
	border-radius: 0.24em;
	border-color: #051a39;
	padding: 0.4em;

}


QPushButton:pressed
{
	background-color: #4969ff;
	color: #ffffff;
	border-style: solid;
	border-width: 0.08em;
	border-radius: 0.24em;
	border-color: #051a39;
	padding: 0.4em;

}


/*-----QToolButton-----*/
QToolButton
{
	background-color: #607cff;
	color: #ffffff;
	border-width: 0.08em;
	border-style: solid;
	border-radius: 0.24em;
	border-color: #051a39;
	padding: 0.24em;

}


QToolButton:disabled
{
	background-color: #404040;
	color: #656565;
	border-color: #051a39;

}


QToolButton:hover
{
	background-color: #8399ff;
	color: #ffffff;
	border-width: 0.08em;
	border-radius: 0.24em;
	border-color: #051a39;
	padding: 0.24em;

}


QToolButton:pressed
{
	background-color: #4969ff;
	color: #ffffff;
	border-width: 0.08em;
	border-radius: 0.24em;
	border-color: #051a39;
	padding: 0.24em;

}


/*-----QComboBox-----*/
QComboBox
{
    background-color: #607cff;
    border: 0.08em solid;
    border-radius: 0.24em;
    padding-left: 0.48em;
    padding-right: 1.6em;
    color: #ffffff;
    min-height: 1.6em;

}


QComboBox:disabled
{
	background-color: #404040;
	color: #656565;
	border-color: #051a39;

}


QComboBox:hover
{
    background-color: #8399ff;

}


QComboBox:on
{
    background-color: #4969ff;

}


QComboBox QAbstractItemView
{
    background-color: #383838;
    color: #ffffff;
    border: 0.08em solid black;
    selection-background-color: #4969ff;
    selection-color: #ffffff;
    outline: 0;

}


QComboBox::drop-down
{
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 1.2em;
    border-left-width: 0;
    border-left-color: darkgray;
    border-left-style: solid; 
    border-top-right-radius: 0.24em; 
    border-bottom-right-radius: 0.24em;

}


QComboBox::down-arrow
{
    image: url(:/qss/darkeum/arrow-down.svg);
    width: 0.64em;
    height: 0.64em;
}


/*-----QSpinBox & QDoubleSpinBox & QDateTimeEdit-----*/
QSpinBox, 
QDoubleSpinBox,
QDateTimeEdit
{
	background-color: #525251;
	color: #ffffff;
	border: 0.08em solid #051a39;
	border-radius: 0.24em;
	padding : 0.16em;
	padding-right: 1.6em;

}


QSpinBox:disabled, 
QDoubleSpinBox:disabled,
QDateTimeEdit:disabled
{
	background-color: #404040;
	color: #656565;
	border-color: #051a39;

}


QSpinBox:hover, 
QDoubleSpinBox:hover,
QDateTimeEdit:hover
{
    background-color: #626262;
    border: 0.08em solid #607cff;
    color:  #fff;
    padding: 0.16em;

}


QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button,
QDateTimeEdit::up-button, QDateTimeEdit::down-button
{
    background-color: #607cff;
	border-radius: 0.16em;

}


QSpinBox:disabled, 
QDoubleSpinBox:disabled,
QDateTimeEdit:disabled
{
	background-color: #404040;
	color: #656565;
	border-color: #051a39;

}


QSpinBox::up-button:hover, QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover,
QDateTimeEdit::up-button:hover, QDateTimeEdit::down-button:hover
{
    background-color: #8399ff;
    border: 0.08em solid #8399ff;

}


QSpinBox::up-button:disabled, QSpinBox::down-button:disabled,
QDoubleSpinBox::up-button:disabled, QDoubleSpinBox::down-button:disabled,
QDateTimeEdit::up-button:disabled, QDateTimeEdit::down-button:disabled
{
	background-color: #404040;
	color: #656565;
	border-color: #051a39;

}


QSpinBox::up-button:pressed, QSpinBox::down-button:pressed,
QDoubleSpinBox::up-button:pressed, QDoubleSpinBox::down-button:pressed,
QDateTimeEdit::up-button:pressed, QDateTimeEdit::down-button:pressed
{
    background-color: #4969ff;
    border: 0.08em solid #4969ff;

}


QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow,
QDateTimeEdit::down-arrow
{
    image: url(:/qss/darkeum/arrow-down.svg);
    width: 0.56em;
    height: 0.56em;

}


QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow,
QDateTimeEdit::up-arrow
{
    image: url(:/qss/darkeum/arrow-up.svg);
    width: 0.56em;
    height: 0.56em;

}


/*-----QLineEdit-----*/
QLineEdit
{
	background-color: #525251;
	color: #ffffff;
	border-width: 0.08em;
	border-style: solid;
	border-radius: 0.24em;
	border-color: #051a39;
	padding: 0.16em;

}


QLineEdit:disabled
{
	background-color: #404040;
	color: #656565;
	border-width: 0.08em;
	border-radius: 0.24em;
	border-color: #051a39;
	padding: 0.16em;

}


/*-----QTextEdit-----*/
QTextEdit, QPlainTextEdit
{
	background-color: #525251;
	color: #ffffff;
	border-color: #051a39;

}


QTextEdit:disabled, QPlainTextEdit:disabled
{
	background-color: #404040;
	color: #656565;
	border-color: #051a39;

}


/*-----QGroupBox-----*/
QGroupBox 
{
    border: 0.08em solid;
    border-color: #607cff;
    margin-top: 2em;
    padding-top: 0.4em;

}


QGroupBox::title  
{
    background-color: #607cff;
    color: #ffffff;
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0.4em;
	border-top-left-radius: 0.24em;
	border-top-right-radius: 0.24em;

}


QGroupBox::title:disabled
{
	background-color: #404040;
	color: #656565;
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0.4em;
	border-top-left-radius: 0.24em;
	border-top-right-radius: 0.24em;

}


/*-----QCheckBox-----*/
QCheckBox::indicator,
QGroupBox::indicator,
QAbstractItemView::indicator
{
    color: #b1b1b1;
    background-color: #323232;
    border: 0.08em solid #b1b1b1;
    width: 0.96em;
    height: 0.96em;

}


QCheckBox::indicator:checked,
QGroupBox::indicator:checked,
QAbstractItemView::indicator:checked
{
    image:url(:/qss/darkeum/checkbox.svg);
    border: 0.08em solid #607cff;

}


QCheckBox::indicator:indeterminate,
QAbstractItemView::indicator:indeterminate
{
    image: url(:/qss/darkeum/checkbox-mixed.svg);
    border: 0.08em solid #607cff;
}

QCheckBox::indicator:focus,
QGroupBox::indicator:focus,
QAbstractItemView::indicator:focus,
QCheckBox::indicator:hover,
QGroupBox::indicator:hover,
QAbstractItemView::indicator:hover
{
    border: 0.08em solid #607cff;

}


QCheckBox:disabled
{
	color: #656565;

}


QCheckBox::indicator:disabled,
QGroupBox::indicator:disabled,
QAbstractItemView::indicator:disabled
{
	background-color: #404040;
	color: #656565;
    border: 0.08em solid #656565;

}


/*-----QRadioButton-----*/
QRadioButton::indicator:unchecked
{ 
	border: 0.16em inset gray; 
	border-radius: 0.4em; 
	background-color:  #fff;
	width: 0.72em; 
	height: 0.72em; 

}


QRadioButton::indicator:unchecked:hover
{ 
	border: 0.16em solid #607cff; 
	border-radius: 0.4em; 
	background-color:  #fff;
	width: 0.72em; 
	height: 0.72em; 

}


QRadioButton::indicator:checked
{ 
	border: 0.16em inset darkgray; 
	border-radius: 0.4em; 
	background-color: #4969ff; 
	width: 0.72em; 
	height: 0.72em; 

}


QRadioButton:disabled
{
	color: #656565;

}


QRadioButton::indicator:disabled
{
	background-color: #656565;
	color: #656565;
    border: 0.16em solid #656565;

}


/*-----QTableView & QTableWidget-----*/
QTableView
{
    background-color: #242526;
    border: 0.08em solid #32414B;
    color: #f0f0f0;
    gridline-color: #8faaff;
    outline : 0;

}


QTableView:disabled
{
    background-color: #242526;
    border: 0.08em solid #32414B;
    color: #656565;
    gridline-color: #656565;
    outline : 0;

}


QTableView::item:hover 
{
    background-color: #26264f;
    color: #f0f0f0;

}


QTableView::item:selected 
{
    background-color: #1a1b1c;
    border: 0.16em solid #4969ff;
    color: #F0F0F0;

}


QTableView::item:selected:disabled
{
    background-color: #1a1b1c;
    border: 0.16em solid #525251;
    color: #656565;

}


QTableCornerButton::section
{
    background-color: #505050;
    color: #fff;

}


QHeaderView::section
{
    background-color: #525251;
    color: #fff;
    text-align: left;
	padding: 0.32em;
	
}


QHeaderView::section:disabled
{
    background-color: #525251;
    color: #656565;

}


QHeaderView::section:checked
{
    color: #fff;
    background-color: #4969ff;

}


QHeaderView::section:checked:disabled
{
    color: #656565;
    background-color: #525251;

}


QHeaderView::section:vertical:first,
QHeaderView::section:vertical:only-one
{
    border-top: 0.08em solid #353635;

}


QHeaderView::section:vertical
{
    border-top: 0.08em solid #353635;

}


QHeaderView::section:horizontal:first,
QHeaderView::section:horizontal:only-one
{
    border-left: 0.08em solid #353635;

}


QHeaderView::section:horizontal
{
    border-left: 0.08em solid #353635;

}


/*-----QTabWidget-----*/
QTabBar::tab
{
	background-color: #262626;
	color: #ffffff;
	border-style: solid;
	border-width: 0.08em;
	border-top-left-radius: 0.24em;
	border-top-right-radius: 0.24em;
	border-color: #051a39;
	padding: 0.4em;

}


QTabBar::tab:disabled
{
	background-color: #656565;
	color: #656565;

}


QTabWidget::pane 
{
	background-color: #262626;
	color: #ffffff;
    border: 0.08em solid;
    border-color: #607cff;

}


QTabBar::tab:selected
{
    background-color: #607cff;
	color: #ffffff;
	border-style: solid;
	border-width: 0.08em;
	border-top-left-radius: 0.24em;
	border-top-right-radius: 0.24em;
	border-color: #051a39;
	padding: 0.4em;

}


QTabBar::tab:selected:disabled
{
	background-color: #404040;
	color: #656565;

}


QTabBar::tab:!selected 
{
    background-color: #262626;

}


QTabBar::tab:!selected:hover 
{
    background-color: #8399ff;

}


QTabBar::tab:top:!selected 
{
    margin-top: 0.24em;

}


QTabBar::tab:bottom:!selected 
{
    margin-bottom: 0.24em;

}


QTabBar::tab:top, QTabBar::tab:bottom 
{
    min-width: 8ex;
    margin-right: -0.08em;
    padding: 0.4em 0.8em 0.4em 0.8em;

}


QTabBar::tab:top:selected 
{
    border-bottom-color: transparent;

}


QTabBar::tab:bottom:selected 
{
    border-top-color: transparent;

}


QTabBar::tab:top:last, QTabBar::tab:bottom:last,
QTabBar::tab:top:only-one, QTabBar::tab:bottom:only-one 
{
    margin-right: 0;

}


QTabBar::tab:left:!selected 
{
    margin-right: 0.24em;

}


QTabBar::tab:right:!selected
{
    margin-left: 0.24em;

}


QTabBar::tab:left, QTabBar::tab:right 
{
    min-height: 8ex;
    margin-bottom: -0.08em;
    padding: 0.8em 0.4em 0.8em 0.4em;

}


QTabBar::tab:left:selected 
{
    border-left-color: transparent;

}


QTabBar::tab:right:selected 
{
    border-right-color: transparent;

}


QTabBar::tab:left:last, QTabBar::tab:right:last,
QTabBar::tab:left:only-one, QTabBar::tab:right:only-one 
{
    margin-bottom: 0;

}


/*-----QSlider-----*/
QSlider::groove:horizontal 
{
	background-color: transparent;
	height: 0.4em;

}


QSlider::sub-page:horizontal 
{
	background-color: #607cff;

}


QSlider::add-page:horizontal 
{
	background-color: #666765;

}


QSlider::handle:horizontal 
{
	background-color: #607cff;
	width: 1.12em;
	margin-top: -0.48em;
	margin-bottom: -0.48em;
	border-radius: 0.24em;

}


QSlider::handle:horizontal:hover 
{
	background-color: #607cff;
	border-radius: 0.24em;

}


QSlider::sub-page:horizontal:disabled 
{
	background-color: #bbb;
	border-color: #999;

}


QSlider::add-page:horizontal:disabled 
{
	background-color: #eee;
	border-color: #999;

}


QSlider::handle:horizontal:disabled 
{
	background-color: #eee;
	border: 0.08em solid #aaa;
	border-radius: 0.24em;

}


QSlider::groove:vertical 
{
	background-color: transparent;
	width: 0.4em;

}


QSlider::sub-page:vertical 
{
	background-color: #607cff;

}


QSlider::add-page:vertical 
{
	background-color: #666765;

}


QSlider::handle:vertical 
{
	background-color: #607cff;
	height: 1.12em;
	margin-left: -0.48em;
	margin-right: -0.48em;
	border-radius: 0.24em;

}


QSlider::handle:vertical:hover 
{
	background-color: #607cff;
	border-radius: 0.24em;

}


QSlider::sub-page:vertical:disabled 
{
	background-color: #bbb;
	border-color: #999;

}


QSlider::add-page:vertical:disabled 
{
	background-color: #eee;
	border-color: #999;

}


QSlider::handle:vertical:disabled 
{
	background-color: #eee;
	border: 0.08em solid #aaa;
	border-radius: 0.24em;

}


/*-----QDial-----*/
QDial
{
	background-color: #607cff;

}


QDial:disabled
{
	background-color: #404040;

}


/*-----QScrollBar-----*/
QScrollBar:horizontal
{
    border: 0.08em solid #222222;
    background-color: #3d3d3d;
    height: 1.04em;
    margin: 0 1.28em 0 1.28em;

}


QScrollBar::handle:horizontal
{
    background: #607cff;
    min-width: 1.6em;

}


QScrollBar::add-line:horizontal
{
    border: 0.08em solid #1b1b19;
    background-color: #607cff;
    width: 1.12em;
    subcontrol-position: right;
    subcontrol-origin: margin;

}


QScrollBar::sub-line:horizontal
{
    border: 0.08em solid #1b1b19;
    background-color: #607cff;
    width: 1.12em;
    subcontrol-position: left;
    subcontrol-origin: margin;

}


QScrollBar::right-arrow:horizontal
{
    image: url(:/qss/darkeum/arrow-right.svg);
    width: 0.48em;
    height: 0.48em;

}


QScrollBar::left-arrow:horizontal
{
    image: url(:/qss/darkeum/arrow-left.svg);
    width: 0.48em;
    height: 0.48em;

}


QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal
{
    background: none;

}


QScrollBar:vertical
{
    background-color: #3d3d3d;
    width: 1.04em;
    margin: 1.28em 0 1.28em 0;
    border: 0.08em solid #222222;

}


QScrollBar::handle:vertical
{
    background-color: #607cff;
    min-height: 1.6em;

}


QScrollBar::add-line:vertical
{
    border: 0.08em solid #1b1b19;
    background-color: #607cff;
    height: 1.12em;
    subcontrol-position: bottom;
    subcontrol-origin: margin;

}


QScrollBar::sub-line:vertical
{
    border: 0.08em solid #1b1b19;
    background-color: #607cff;
    height: 1.12em;
    subcontrol-position: top;
    subcontrol-origin: margin;

}


QScrollBar::up-arrow:vertical
{
    image: url(:/qss/darkeum/arrow-up.svg);
    width: 0.48em;
    height: 0.48em;

}


QScrollBar::down-arrow:vertical
{
    image: url(:/qss/darkeum/arrow-down.svg);
    width: 0.48em;
    height: 0.48em;

}


QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical
{
    background: none;

}


/*-----QProgressBar-----*/
QProgressBar
{
	background-color: #383838;
	color: #ffffff;
	border: 0.08em solid #607cff;
	border-radius: 0.24em;
	text-align: center;

}


QProgressBar::chunk {
	background-color: #607cff;
	color: #fff;

}


QProgressBar::chunk:disabled {
	background-color: #656565;
	border: 0.08em solid #aaa;
	color: #656565;
}


/*-----QStatusBar-----*/
QStatusBar
{
	background-color: #0a0a0a;
	color: #ffffff;
	border-color: #051a39;

}
