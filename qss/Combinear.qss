/*-----QWidget-----*/
QWidget
{
	background-color: #3a3a3a;
	color: #fff;
	selection-background-color: #b78620;
	selection-color: #000;

}


/*-----QLabel-----*/
QLabel
{
	background-color: transparent;
	color: #fff;

}


/*-----QMenuBar-----*/
QMenuBar 
{
	background-color: qlineargradient(spread:repeat, x1:1, y1:0, x2:1, y2:1, stop:0 rgba(57, 57, 57, 255),stop:1 rgba(50, 50, 50, 255));
	border: 0.08em solid #000;
	color: #fff;

}


QMenuBar::item 
{
	background-color: transparent;

}


QMenuBar::item:selected 
{
	background-color: rgba(183, 134, 32, 20%);
	border: 0.08em solid #b78620;
	color: #fff;

}


QMenuBar::item:pressed 
{
	background-color: rgb(183, 134, 32);
	border: 0.08em solid #b78620;
	color: #fff;

}


/*-----QMenu-----*/
QMenu
{
    background-color: qlineargradient(spread:repeat, x1:1, y1:0, x2:1, y2:1, stop:0 rgba(57, 57, 57, 255),stop:1 rgba(50, 50, 50, 255));
    border: 0.08em solid #222;
    padding: 0.32em;
	color: #fff;

}


QMenu::item
{
    background-color: transparent;
    padding: 0.16em 1.6em 0.16em 1.6em;

}


QMenu::separator
{
   	background-color: rgb(183, 134, 32);
	height: 0.08em;

}


QMenu::item:disabled
{
    color: #555;
    background-color: transparent;
    padding: 0.16em 1.6em 0.16em 1.6em;

}


QMenu::item:selected
{
	background-color: rgba(183, 134, 32, 20%);
	border: 0.08em solid #b78620;
	color: #fff;

}


/*-----QToolBar-----*/
QToolBar
{
	background-color: qlineargradient(spread:repeat, x1:1, y1:0, x2:1, y2:1, stop:0 rgba(69, 69, 69, 255),stop:1 rgba(58, 58, 58, 255));
	border-top: none;
	border-bottom: 0.08em solid #4f4f4f;
	border-left: 0.08em solid #4f4f4f;
	border-right: 0.08em solid #4f4f4f;

}


QToolBar::separator
{
	background-color: #2e2e2e;
	width: 0.08em;

}


/*-----QToolButton-----*/
QToolButton 
{
	background-color: transparent;
	color: #fff;
	padding: 0.4em;
	padding-left: 0.64em;
	padding-right: 0.64em;
	margin-left: 0.08em;
}


QToolButton:hover
{
	background-color: rgba(183, 134, 32, 20%);
	border: 0.08em solid #b78620;
	color: #fff;
	
}


QToolButton:pressed
{
	background-color: qlineargradient(spread:repeat, x1:1, y1:0, x2:1, y2:1, stop:0 rgba(57, 57, 57, 255),stop:1 rgba(50, 50, 50, 255));
	border: 0.08em solid #b78620;

}


QToolButton:checked
{
	background-color: qlineargradient(spread:repeat, x1:1, y1:0, x2:1, y2:1, stop:0 rgba(57, 57, 57, 255),stop:1 rgba(50, 50, 50, 255));
	border: 0.08em solid #222;
}


/*-----QPushButton-----*/
QPushButton
{
	background-color: qlineargradient(spread:repeat, x1:1, y1:0, x2:1, y2:1, stop:0 rgba(84, 84, 84, 255),stop:1 rgba(59, 59, 59, 255));
	color: #ffffff;
	min-width: 6.4em;
	border-style: solid;
	border-width: 0.08em;
	border-radius: 0.24em;
	border-color: #051a39;
	padding: 0.4em;

}


QPushButton:flat
{
	background-color: transparent;
	border: none;
	color: #fff;

}


QPushButton:disabled
{
	background-color: #404040;
	color: #656565;
	border-color: #051a39;

}


QPushButton:hover
{
	background-color: rgba(183, 134, 32, 20%);
	border: 0.08em solid #b78620;

}


QPushButton:pressed
{
	background-color: qlineargradient(spread:repeat, x1:1, y1:0, x2:1, y2:1, stop:0 rgba(74, 74, 74, 255),stop:1 rgba(49, 49, 49, 255));
	border: 0.08em solid #b78620;

}


QPushButton:checked
{
	background-color: qlineargradient(spread:repeat, x1:1, y1:0, x2:1, y2:1, stop:0 rgba(74, 74, 74, 255),stop:1 rgba(49, 49, 49, 255));
	border: 0.08em solid #222;

}


/*-----QLineEdit-----*/
QLineEdit
{
	background-color: #131313;
	color : #eee;
	border: 0.08em solid #343434;
	border-radius: 0.16em;
	padding: 0.24em;
	padding-left: 0.4em;

}


/*-----QPlainTExtEdit-----*/
QPlainTextEdit
{
	background-color: #131313;
	color : #eee;
	border: 0.08em solid #343434;
	border-radius: 0.16em;
	padding: 0.24em;
	padding-left: 0.4em;

}


/*-----QTabBar-----*/
QTabBar::tab
{
	background-color: qlineargradient(spread:repeat, x1:1, y1:0, x2:1, y2:1, stop:0 rgba(84, 84, 84, 255),stop:1 rgba(59, 59, 59, 255));
	color: #ffffff;
	border-style: solid;
	border-width: 0.08em;
	border-color: #666;
	border-bottom: none;
	padding: 0.4em;
	padding-left: 1.2em;
	padding-right: 1.2em;

}


QTabWidget::pane 
{
	background-color: #3a3a3a;
	border: 0.08em solid #666;
	top: 0.08em;

}


QTabBar::tab:last
{
	margin-right: 0; 

}


QTabBar::tab:first:!selected
{
	background-color: #0c0c0d;
	margin-left: 0;

}


QTabBar::tab:!selected
{
	color: #b1b1b1;
	border-bottom-style: solid;
	background-color: #0c0c0d;

}


QTabBar::tab:selected
{
	margin-bottom: 0;

}


QTabBar::tab:!selected:hover
{
	border-top-color: #b78620;

}


/*-----QComboBox-----*/
QComboBox
{
    background-color: qlineargradient(spread:repeat, x1:1, y1:0, x2:1, y2:1, stop:0 rgba(84, 84, 84, 255),stop:1 rgba(59, 59, 59, 255));
    border: 0.08em solid #000;
    padding-left: 0.48em;
    color: #ffffff;
    min-height: 1.6em;
    padding-right: 1.6em;

}


QComboBox:disabled
{
	background-color: #404040;
	color: #656565;
	border-color: #051a39;

}


QComboBox:on
{
    background-color: #b78620;
	color: #000;

}


QComboBox QAbstractItemView
{
    background-color: #383838;
    color: #ffffff;
    border: 0.08em solid black;
    selection-background-color: #b78620;
    selection-color: #000;
    outline: 0;

}


QComboBox::drop-down
{
	background-color: qlineargradient(spread:repeat, x1:1, y1:0, x2:1, y2:1, stop:0 rgba(57, 57, 57, 255),stop:1 rgba(50, 50, 50, 255));
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 1.2em;
    border-left-width: 0.08em;
    border-left-color: black;
    border-left-style: solid; 

}


QComboBox::down-arrow
{
    image: url(:/qss/darkeum/arrow-down.svg);
    width: 0.64em;
    height: 0.64em;
}


/*-----QSpinBox & QDoubleSpinBox & QDateTimeEdit-----*/
QSpinBox, QDoubleSpinBox,
QDateTimeEdit 
{
    background-color: #131313;
	color : #eee;
	border: 0.08em solid #343434;
	padding: 0.24em;
	padding-left: 0.4em;
	padding-right: 1.6em;
    border-radius : 0.16em;

}


QSpinBox::up-button, QDoubleSpinBox::up-button, 
QDateTimeEdit::up-button
{
	border-top-right-radius:0.16em;
	background-color: #777777;
    width: 1.28em; 
    border-width: 0.08em;

}


QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover, 
QDateTimeEdit::up-button:hover
{
	background-color: #585858;

}


QSpinBox::up-button:pressed, QDoubleSpinBox::up-button:pressed, 
QDateTimeEdit::up-button:pressed
{
	background-color: #252525;
    width: 1.28em; 
    border-width: 0.08em;

}


QSpinBox::up-arrow, QDoubleSpinBox::up-arrow,
QDateTimeEdit::up-arrow
{
    image: url(:/qss/darkeum/arrow-up.svg);
    width: 0.56em;
    height: 0.56em;

}


QSpinBox::down-button, QDoubleSpinBox::down-button, 
QDateTimeEdit::down-button
{
	border-bottom-right-radius:0.16em;
	background-color: #777777;
    width: 1.28em; 
    border-width: 0.08em;

}


QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover, 
QDateTimeEdit::down-button:hover
{
	background-color: #585858;

}


QSpinBox::down-button:pressed, QDoubleSpinBox::down-button:pressed, 
QDateTimeEdit::down-button:pressed
{
	background-color: #252525;
    width: 1.28em; 
    border-width: 0.08em;

}


QSpinBox::down-arrow, QDoubleSpinBox::down-arrow,
QDateTimeEdit::down-arrow
{
    image: url(:/qss/darkeum/arrow-down.svg);
    width: 0.56em;
    height: 0.56em;

}


/*-----QGroupBox-----*/
QGroupBox 
{
    border: 0.08em solid;
    border-color: #666666;
	border-radius: 0.4em;
    margin-top: 2em;
    padding-top: 0.4em;

}


QGroupBox::title  
{
    background-color: transparent;
    color: #eee;
    subcontrol-origin: margin;
    padding: 0.4em;
	border-top-left-radius: 0.24em;
	border-top-right-radius: 0.24em;

}


/*-----QHeaderView-----*/
QHeaderView::section
{
    background-color: qlineargradient(spread:repeat, x1:1, y1:0, x2:1, y2:1, stop:0 rgba(60, 60, 60, 255),stop:1 rgba(50, 50, 50, 255));
	border: 0.08em solid #000;
    color: #fff;
    text-align: left;
	padding: 0.32em;
	
}


QHeaderView::section:disabled
{
    background-color: #525251;
    color: #656565;

}


QHeaderView::section:checked
{
    background-color: qlineargradient(spread:repeat, x1:1, y1:0, x2:1, y2:1, stop:0 rgba(60, 60, 60, 255),stop:1 rgba(50, 50, 50, 255));
    color: #fff;

}


QHeaderView::section:vertical:first,
QHeaderView::section:vertical:only-one
{
    border-top: 0.08em solid #353635;

}


QHeaderView::section:vertical
{
    border-top: 0.08em solid #353635;

}


QHeaderView::section:horizontal:first,
QHeaderView::section:horizontal:only-one
{
    border-left: 0.08em solid #353635;

}


QHeaderView::section:horizontal
{
    border-left: 0.08em solid #353635;

}


QTableCornerButton::section
{
    background-color: qlineargradient(spread:repeat, x1:1, y1:0, x2:1, y2:1, stop:0 rgba(60, 60, 60, 255),stop:1 rgba(50, 50, 50, 255));
	border: 0.08em solid #000;
    color: #fff;

}


/*-----QTreeWidget-----*/
QTreeView
{
	show-decoration-selected: 1;
	alternate-background-color: #3a3a3a;
	selection-color: #fff;
	background-color: #2d2d2d;
	border: 0.08em solid gray;
	padding-top : 0.4em;
	color: #fff;
	

}


QTreeView::item:selected
{
	color:#000;
	background-color: #b78620;
	border-radius: 0;

}


QTreeView::item:!selected:hover
{
    background-color: #262626;
    border: none;
    color: white;

}


QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings 
{
	image: url(:/qss/darkeum/arrow-right.svg);

}


QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings  
{
	image: url(:/qss/darkeum/arrow-down.svg);

}


/*-----QListView-----*/
QListView 
{
	background-color: qlineargradient(spread:repeat, x1:1, y1:0, x2:1, y2:1, stop:0 rgba(83, 83, 83, 255),stop:0.293269 rgba(81, 81, 81, 255),stop:0.634615 rgba(79, 79, 79, 255),stop:1 rgba(83, 83, 83, 255));
    border : none;
    color: white;
    show-decoration-selected: 1; 
    outline: 0;
	border: 0.08em solid gray;

}


QListView:disabled 
{
	background-color: #656565;
	color: #1b1b1b;
    border: 0.08em solid #656565;

}


QListView::item 
{
	background-color: #2d2d2d;
    padding: 0.08em;

}


QListView::item:alternate 
{
    background-color: #3a3a3a;

}


QListView::item:selected 
{
	background-color: #b78620;
	border: 0.08em solid #b78620;
	color: #000;

}


QListView::item:selected:!active 
{
	background-color: #b78620;
	border: 0.08em solid #b78620;
	color: #000;

}


QListView::item:selected:active 
{
	background-color: #b78620;
	border: 0.08em solid #b78620;
	color: #000;

}


QListView::item:hover {
    background-color: #262626;
    border: none;
    color: white;

}


/*-----QCheckBox-----*/
QCheckBox
{
	background-color: transparent;
    color: lightgray;
	border: none;

}


QCheckBox::indicator,
QGroupBox::indicator,
QAbstractItemView::indicator
{
    background-color: #323232;
    border: 0.08em solid darkgray;
    width: 0.96em;
    height: 0.96em;

}


QCheckBox::indicator:checked,
QGroupBox::indicator:checked,
QAbstractItemView::indicator:checked
{
    image:url(:/qss/darkeum/checkbox.svg);
	background-color: #b78620;
    border: 0.08em solid #b78620;

}


QCheckBox::indicator:indeterminate,
QAbstractItemView::indicator:indeterminate
{
    image: url(:/qss/darkeum/checkbox-mixed.svg);
    background-color: #b78620;
    border: 0.08em solid #b78620;
}

QCheckBox::indicator:hover,
QGroupBox::indicator:hover,
QAbstractItemView::indicator:hover
{
	border: 0.08em solid #b78620; 

}


QCheckBox:disabled
{
	color: #656565;

}


QCheckBox::indicator:disabled,
QGroupBox::indicator:disabled,
QAbstractItemView::indicator:disabled
{
	background-color: #656565;
	color: #656565;
    border: 0.08em solid #656565;

}


/*-----QRadioButton-----*/
QRadioButton 
{
	color: lightgray;
	background-color: transparent;

}


QRadioButton::indicator:unchecked:hover 
{
	background-color: lightgray;
	border: 0.16em solid #b78620;
	border-radius: 0.48em;
}


QRadioButton::indicator:checked 
{
	border: 0.16em solid #b78620;
	border-radius: 0.48em;
	background-color: rgba(183,134,32,20%);  
	width: 0.72em; 
	height: 0.72em; 

}


/*-----QSlider-----*/
QSlider::groove:horizontal 
{
	background-color: transparent;
	height: 0.24em;

}


QSlider::sub-page:horizontal 
{
	background-color: #b78620;

}


QSlider::add-page:horizontal 
{
	background-color: #131313;

}


QSlider::handle:horizontal 
{
	background-color: #b78620;
	width: 1.12em;
	margin-top: -0.48em;
	margin-bottom: -0.48em;
	border-radius: 0.48em;

}


QSlider::handle:horizontal:hover 
{
	background-color: #d89e25;
	border-radius: 0.48em;

}


QSlider::sub-page:horizontal:disabled 
{
	background-color: #bbb;
	border-color: #999;

}


QSlider::add-page:horizontal:disabled 
{
	background-color: #eee;
	border-color: #999;

}


QSlider::handle:horizontal:disabled 
{
	background-color: #eee;
	border: 0.08em solid #aaa;
	border-radius: 0.24em;

}


/*-----QScrollBar-----*/
QScrollBar:horizontal
{
    border: 0.08em solid #222222;
    background-color: #3d3d3d;
    height: 1.2em;
    margin: 0 1.28em 0 1.28em;

}


QScrollBar::handle:horizontal
{
	background-color: qlineargradient(spread:repeat, x1:1, y1:0, x2:1, y2:1, stop:0 rgba(97, 97, 97, 255),stop:1 rgba(90, 90, 90, 255));
	border: 0.08em solid #2d2d2d;
    min-width: 1.6em;

}


QScrollBar::add-line:horizontal
{
	background-color: qlineargradient(spread:repeat, x1:1, y1:0, x2:1, y2:1, stop:0 rgba(97, 97, 97, 255),stop:1 rgba(90, 90, 90, 255));
	border: 0.08em solid #2d2d2d;
    width: 1.2em;
    subcontrol-position: right;
    subcontrol-origin: margin;

}


QScrollBar::sub-line:horizontal
{
	background-color: qlineargradient(spread:repeat, x1:1, y1:0, x2:1, y2:1, stop:0 rgba(97, 97, 97, 255),stop:1 rgba(90, 90, 90, 255));
	border: 0.08em solid #2d2d2d;
    width: 1.2em;
    subcontrol-position: left;
    subcontrol-origin: margin;

}


QScrollBar::right-arrow:horizontal
{
    image: url(:/qss/darkeum/arrow-right.svg);
    width: 0.48em;
    height: 0.48em;

}


QScrollBar::left-arrow:horizontal
{
    image: url(:/qss/darkeum/arrow-left.svg);
    width: 0.48em;
    height: 0.48em;

}


QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal
{
    background: none;

}


QScrollBar:vertical
{
    background-color: #3d3d3d;
    width: 1.28em;
	border: 0.08em solid #2d2d2d;
    margin: 1.28em 0 1.28em 0;

}


QScrollBar::handle:vertical
{
    background-color: qlineargradient(spread:repeat, x1:1, y1:0, x2:1, y2:1, stop:0 rgba(97, 97, 97, 255),stop:1 rgba(90, 90, 90, 255));
	border: 0.08em solid #2d2d2d;
    min-height: 1.6em;

}


QScrollBar::add-line:vertical
{
	background-color: qlineargradient(spread:repeat, x1:1, y1:0, x2:1, y2:1, stop:0 rgba(97, 97, 97, 255),stop:1 rgba(90, 90, 90, 255));
	border: 0.08em solid #2d2d2d;
    height: 1.2em;
    subcontrol-position: bottom;
    subcontrol-origin: margin;

}


QScrollBar::sub-line:vertical
{
	background-color: qlineargradient(spread:repeat, x1:1, y1:0, x2:1, y2:1, stop:0 rgba(97, 97, 97, 255),stop:1 rgba(90, 90, 90, 255));
	border: 0.08em solid #2d2d2d;
    height: 1.2em;
    subcontrol-position: top;
    subcontrol-origin: margin;

}


QScrollBar::up-arrow:vertical
{
    image: url(:/qss/darkeum/arrow-up.svg);
    width: 0.48em;
    height: 0.48em;

}


QScrollBar::down-arrow:vertical
{
    image: url(:/qss/darkeum/arrow-down.svg);
    width: 0.48em;
    height: 0.48em;

}


QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical
{
    background: none;

}


/*-----QProgressBar-----*/
QProgressBar
{
    border: 0.08em solid #666666;
    text-align: center;
	color: #000;
	font-weight: bold;

}


QProgressBar::chunk
{
    background-color: #b78620;
    width: 2.4em;
    margin: 0.0.4em;

}
